---
// Floating glass navigation bar at the top of every page.
import { url } from '../config';

const links = [
  { href: '/', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

// Works out which link is the current page so it can be highlighted.
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) =>
  href === '/' ? here === '/' || here === '' : here.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-[max(1rem,env(safe-area-inset-top))]">
  <nav
    class="glass mx-auto flex max-w-4xl items-center justify-between rounded-full py-2 pr-2 pl-4"
    aria-label="Main"
  >
    <a href={url('/')} class="font-semibold tracking-tight text-white">
      <span class="text-gradient">AZ</span><span class="hidden sm:inline"> · Anas Zokronain</span>
    </a>
    <ul class="flex items-center gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={url(link.href)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
                isActive(link.href)
                  ? 'bg-white/10 text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.15)]'
                  : 'text-slate-400 hover:text-white',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

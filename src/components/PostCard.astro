---
// One blog post preview card, used on the Home and Blog pages.
import { url } from '../config';

interface Props {
  id: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { id, title, description, date, tags } = Astro.props;
const dateText = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a href={url(`/blog/${id}`)} class="glass glass-hover block rounded-2xl p-5 sm:p-6">
  <time datetime={date.toISOString()} class="font-mono text-xs text-slate-400">{dateText}</time>
  <h3 class="mt-2 text-lg font-semibold text-white">{title}</h3>
  <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => <span class="chip">#{tag}</span>)}
      </div>
    )
  }
</a>

---
// CONTACT PAGE: email link plus optional LinkedIn and GitHub (set them in src/config.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const others = [
  { label: 'LinkedIn', href: SITE.linkedin },
  { label: 'GitHub', href: SITE.github },
].filter((item) => item.href);
---

<BaseLayout title="Contact" description={`Get in touch with ${SITE.name}.`}>
  <section class="glass rounded-3xl p-6 text-center sm:p-12">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">Contact</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Let's <span class="text-gradient">talk</span>
    </h1>
    <p class="mx-auto mt-4 max-w-md leading-relaxed text-slate-400">
      Questions about structural design, BIM workflows, Revit, or something I wrote? Send me an email.
    </p>

    <a
      href={`mailto:${SITE.email}`}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-accent-blue to-accent-green px-6 py-3 font-semibold text-ink"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      Email me
    </a>
    <p class="mt-3 font-mono text-sm break-all text-slate-400">{SITE.email}</p>

    {
      others.length > 0 && (
        <div class="mt-8 flex justify-center gap-3">
          {others.map((item) => (
            <a href={item.href} class="glass glass-hover rounded-full px-5 py-2 text-sm text-white" rel="me">
              {item.label}
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
